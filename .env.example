DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"
AUTH_SECRET="change-me"
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SUPABASE_URL="https://example.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="change-me"
TAX_INVOICE_API_KEY="change-me"

# 매장 검색(상호 검색) — Kakao 로컬 API REST API 키 (선택)
# - 비워두면 매장 모달의 "매장 검색" 버튼이 숨겨지고 /api/places/search 는 503 응답 (주소 검색은 그대로 동작)
# - 서버 전용: NEXT_PUBLIC_ 접두사를 붙이지 말 것 (브라우저에 키가 노출됨)
# - 발급: https://developers.kakao.com → 내 애플리케이션 → 앱 키 → REST API 키, 카카오맵 API 활성화 필요
KAKAO_REST_API_KEY=""

# 점검 모드 토글 ("true" / "1" / "on" 으로 설정하면 모든 요청을 차단한다)
# - 모든 페이지 → /maintenance 로 rewrite
# - 모든 API → 503 JSON 응답
MAINTENANCE_MODE="false"
