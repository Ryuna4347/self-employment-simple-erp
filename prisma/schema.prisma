generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String          @id @default(cuid())
  loginId        String          @unique
  name           String
  password       String?
  role           Role            @default(USER)
  inviteCode     String?         @unique
  isDeleted      Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  expenses       Expense[]
  RefreshToken   RefreshToken[]
  storeTemplates StoreTemplate[]
  workRecords                  WorkRecord[]
  collectedWorkRecords         WorkRecord[]           @relation("collectedByUser")
  assignedStores               Store[]                @relation("assignedStores")
  collectionRequests           CollectionRequest[]    @relation("collectionRequester")
  reviewedCollectionRequests   CollectionRequest[]    @relation("collectionReviewer")
  notices                      Notice[]
  recurringCosts               RecurringCost[]
}

model Store {
  id              String                @id @default(cuid())
  name            String
  address         String
  managerName     String?
  PaymentType     PaymentType           @default(CASH)
  kakaoPlaceId    String?               @unique
  latitude        Float?
  longitude       Float?
  receiptType     ReceiptType       @default(NONE)  // 영수증 발급 종류
  note            String?           // 특이사항
  assignedUserId  String?
  isDeleted       Boolean               @default(false)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  assignedUser    User?                 @relation("assignedStores", fields: [assignedUserId], references: [id], onDelete: SetNull)
  storeItems           StoreItem[]
  templateMembers      StoreTemplateMember[]
  workRecords          WorkRecord[]
  collectionRequests   CollectionRequest[]

  @@index([isDeleted])                           // stores: 소프트 삭제 필터
}

model StoreItem {
  id       String @id @default(cuid())
  storeId  String
  name     String
  amount   Int    @default(0)
  quantity Int    @default(0)
  store    Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

model StoreTemplate {
  id          String                @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  userId      String
  creator     User                  @relation(fields: [userId], references: [id])
  members     StoreTemplateMember[]
}

model StoreTemplateMember {
  id         String        @id @default(cuid())
  templateId String
  storeId    String
  order      Int           @default(0)
  store      Store         @relation(fields: [storeId], references: [id])
  template   StoreTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
}

model WorkRecord {
  id                   String           @id @default(cuid())
  date                 DateTime         @default(now())
  storeId              String?          // nullable로 변경 (직접 입력 시 null)
  userId               String
  collectionStatus     CollectionStatus @default(UNCOLLECTED)
  imageUrl             String?          // 이미지 URL (Supabase Storage)
  note                 String?
  // 스냅샷 필드 (거래 시점의 매장 정보)
  storeNameSnapshot    String?      // 매장명 스냅샷
  storeAddressSnapshot String?      // 주소 스냅샷
  managerNameSnapshot  String?      // 담당자 스냅샷
  paymentTypeSnapshot  PaymentType  // 결제 방식 스냅샷
  sortOrder            Int          @default(0) // 코스 적용 시 정렬 순서
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  collectedAt          DateTime?    // 수금완료 처리 시점
  collectedByUserId    String?      // 수금완료 처리한 사용자
  items                    RecordItem[]
  collectionRequestItems   CollectionRequestItem[]
  store                    Store?       @relation(fields: [storeId], references: [id], onDelete: SetNull)
  user                     User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  collectedBy              User?        @relation("collectedByUser", fields: [collectedByUserId], references: [id], onDelete: SetNull)

  @@index([date])                                // dashboard: date range 단독 조회
  @@index([userId, date])                        // work-records: 사용자별 날짜 조회
  @@index([storeId, collectionStatus])           // 매장별 미수금 + store-visits
  @@index([collectionStatus, date])              // outstanding: 날짜별 필터
  @@index([collectionStatus, storeNameSnapshot]) // outstanding: 매장별 필터
}

model RecordItem {
  id           String     @id @default(cuid())
  workRecordId String
  name         String
  amount       Int
  quantity     Int
  workRecord   WorkRecord @relation(fields: [workRecordId], references: [id], onDelete: Cascade)
}

model Expense {
  id          String   @id @default(cuid())
  date        DateTime
  userId      String
  title       String
  amount      Int
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([date])
  @@index([userId])
}

model RefreshToken {
  id         String   @id
  tokenHash  String   @unique
  userId     String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  rememberMe Boolean  @default(false)
  User       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId])
}

model Notice {
  id        String    @id @default(cuid())
  title     String
  content   String
  expiresAt DateTime? // 만료일 (null = 무기한)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  authorId  String
  author    User      @relation(fields: [authorId], references: [id])

  @@index([createdAt])
}

model RecurringCost {
  id              String                  @id @default(cuid())
  name            String
  amount          Int
  frequency       RecurringCostFrequency
  isActive        Boolean                 @default(true)
  lastGeneratedAt DateTime?               // 크론용: 마지막 자동 생성 시점
  userId          String
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  user            User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// db에 url 정보를 넣는 것은 7 버전 이후 제거 -> prisma-client-js 사용 시 필요
enum Role {
  ADMIN
  USER
}

enum PaymentType {
  CASH
  ACCOUNT
  CARD
}

enum ReceiptType {
  NONE
  SIMPLE_RECEIPT
  TRANSACTION_STATEMENT
}

enum CollectionStatus {
  UNCOLLECTED  // 미수
  COLLECTED    // 수금완료
  CLOSED       // 휴업&폐업
}

enum RecurringCostFrequency {
  WEEKLY    // 매주 월요일 자동 생성
  MONTHLY   // 매월 1일 자동 생성
}

enum CollectionRequestStatus {
  PENDING   // 대기 중
  APPROVED  // 승인됨
  REJECTED  // 거부됨
}

model CollectionRequest {
  id                String                  @id @default(cuid())
  storeId           String?
  storeNameSnapshot String
  requesterId       String
  status            CollectionRequestStatus @default(PENDING)
  reviewerId        String?
  reviewedAt        DateTime?
  note              String?
  createdAt         DateTime                @default(now())

  requester User                    @relation("collectionRequester", fields: [requesterId], references: [id])
  reviewer  User?                   @relation("collectionReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  store     Store?                  @relation(fields: [storeId], references: [id], onDelete: SetNull)
  items     CollectionRequestItem[]

  @@index([status])
  @@index([requesterId])
  @@index([storeId, status])
}

model CollectionRequestItem {
  id                  String @id @default(cuid())
  collectionRequestId String
  workRecordId        String

  collectionRequest CollectionRequest @relation(fields: [collectionRequestId], references: [id], onDelete: Cascade)
  workRecord        WorkRecord        @relation(fields: [workRecordId], references: [id], onDelete: Cascade)

  @@unique([collectionRequestId, workRecordId])
}
